{
  "version": 1,
  "api": {
    "currentUrl": "https://api.openweathermap.org/data/2.5/weather",
    "forecastUrl": "https://api.openweathermap.org/data/2.5/forecast",
    "units": "metric",
    "timeoutMs": 8000
  },
  "timing": {
    "autoRefreshMs": 600000,
    "minRefreshMs": 120000
  },
  "location": {
    "fallbackLat": 8.37,
    "fallbackLon": 124.87,
    "fallbackLabel": "Manolo Fortich",
    "coordDecimals": 3,
    "lastKnownMaxAgeMs": 120000
  },
  "cache": {
    "todayMinutes": 15,
    "staleMinutes": 30
  },
  "calibration": {
    "tempOffsetC": 0
  },
  "thresholds": {
    "hotC": 30,
    "coldC": 20,
    "cloudLowPct": 25,
    "cloudHighPct": 60,
    "clearShareForHigh": 0.5
  },
  "classification": {
    "ranges": [
      { "min": 200, "max": 232, "label": "Thunderstorm", "severity": "severe" },
      { "min": 300, "max": 321, "label": "Drizzle", "severity": "light" },
      { "min": 500, "max": 500, "label": "Light rain", "severity": "light" },
      { "min": 501, "max": 501, "label": "Moderate rain", "severity": "moderate" },
      { "min": 502, "max": 519, "label": "Heavy rain", "severity": "severe" },
      { "min": 520, "max": 531, "label": "Showers", "severity": "severe" },
      { "min": 600, "max": 622, "label": "Snow", "severity": "severe" },
      { "min": 701, "max": 762, "label": "Hazy", "severity": "fog" },
      { "id": 771, "label": "Squalls", "severity": "severe" },
      { "id": 781, "label": "Tornado", "severity": "severe" },
      { "id": 800, "day": "Sunny", "night": "Clear", "severity": "clear" },
      { "id": 801, "day": "Mostly sunny", "night": "Mostly clear", "severity": "cloudy" },
      { "id": 802, "day": "Partly sunny", "night": "Partly cloudy", "severity": "cloudy" },
      { "id": 803, "label": "Mostly cloudy", "severity": "cloudy" },
      { "id": 804, "label": "Overcast", "severity": "cloudy" }
    ],
    "confirmRange": { "min": 300, "max": 531, "drizzleMax": 321, "confirmMinMm": 0.2 },
    "rainPossibleLabel": "Rain possible",
    "drizzlePossibleLabel": "Drizzle possible",
    "unconfirmedSubtext": "Not confirmed nearby",
    "unavailableLabel": "Condition unavailable",
    "estimateSubtext": "Estimate",
    "iconsByCode": {
      "01d": "sunny-outline",
      "01n": "moon-outline",
      "02d": "partly-sunny-outline",
      "02n": "cloudy-night-outline",
      "03d": "cloud-outline",
      "03n": "cloud-outline",
      "04d": "cloud-outline",
      "04n": "cloud-outline",
      "09d": "rainy-outline",
      "09n": "rainy-outline",
      "10d": "rainy-outline",
      "10n": "rainy-outline",
      "11d": "thunderstorm-outline",
      "11n": "thunderstorm-outline",
      "13d": "snow-outline",
      "13n": "snow-outline",
      "50d": "cloud-outline",
      "50n": "cloud-outline"
    },
    "skyNote": "Condition comes from OpenWeather's standard codes. Not solar power."
  },
  "conditions": {
    "fallback": {
      "icon": "partly-sunny-outline",
      "severity": "clear"
    },
    "rules": [
      {
        "match": ["thunder", "storm"],
        "icon": "thunderstorm-outline",
        "severity": "severe"
      },
      {
        "match": ["snow", "sleet", "ice", "freezing"],
        "icon": "snow-outline",
        "severity": "severe"
      },
      {
        "match": ["heavy", "violent", "torrential", "extreme", "hail"],
        "icon": "rainy-outline",
        "severity": "severe"
      },
      {
        "match": ["moderate"],
        "icon": "rainy-outline",
        "severity": "moderate"
      },
      {
        "match": ["drizzle", "light", "slight", "patchy", "shower", "rain"],
        "icon": "rainy-outline",
        "severity": "light"
      },
      {
        "match": ["fog", "mist", "haze", "smoke", "dust", "sand", "ash"],
        "icon": "cloud-outline",
        "severity": "fog"
      },
      {
        "match": ["partly", "few", "scattered", "broken"],
        "icon": "partly-sunny-outline",
        "severity": "cloudy"
      },
      {
        "match": ["cloud", "overcast"],
        "icon": "cloud-outline",
        "severity": "cloudy"
      },
      {
        "match": ["clear", "sunny"],
        "icon": "sunny-outline",
        "severity": "clear"
      }
    ]
  },
  "severityRanks": {
    "clear": 0,
    "cloudy": 1,
    "fog": 2,
    "light": 3,
    "moderate": 4,
    "severe": 5
  },
  "forecast": {
    "days": 5,
    "peakRule": "max-severity",
    "tieBreak": "nearest-midday",
    "fallbackDescription": "Clear sky",
    "dateFormat": {
      "weekday": "short",
      "month": "short",
      "day": "numeric"
    },
    "bestSunSummary": {
      "good": "Best sun: {day} — good day to charge fully.",
      "poor": "Low sun all week — conserve battery."
    }
  },
  "messages": {
    "errors": {
      "missing_key": "Weather API key is missing. Set EXPO_PUBLIC_OWM_KEY in the .env file.",
      "permission_denied": "Location permission was denied. Enable location access to get the current weather.",
      "services_disabled": "Location services are disabled on this device. Turn them on to get the current weather.",
      "invalid_coordinates": "The device returned invalid GPS coordinates.",
      "location_unavailable": "Could not determine your location. Try again with GPS enabled.",
      "api": "OpenWeather API returned HTTP {status}.",
      "invalid_json": "OpenWeather returned a response that is not valid JSON.",
      "invalid_response": "OpenWeather returned an unexpected response structure.",
      "missing_temperature": "OpenWeather response is missing a valid temperature.",
      "missing_description": "OpenWeather response is missing a weather description.",
      "timeout": "Weather request timed out after {seconds} seconds.",
      "network": "Could not reach OpenWeather. {detail}"
    }
  },
  "formats": {
    "tempDecimals": 0,
    "coordFallback": "{lat}, {lon}",
    "coordDecimals": 2,
    "time": "h:mm AM"
  }
}
