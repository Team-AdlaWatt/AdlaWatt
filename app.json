{
  "expo": {
    "name": "AdlaWatt",
    "slug": "ADLAWATT-",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/adlawatt-icon.png",
    "scheme": "adlawatt",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": "e552de68cf047f8c4681281ab6000865d965616a",
    "updates": {
      "url": "https://u.expo.dev/ba375929-16f4-4a21-b339-8b43e93ecfd2"
    },
    "ios": {
      "icon": "./assets/images/adlawatt-icon.png",
      "bundleIdentifier": "com.teamadlawatt.adlawatt",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/adlawatt-icon.png"
      },
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.teamadlawatt.adlawatt",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/adlawatt-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AdlaWatt to access your photos so you can add a picture to your custom electronics."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F0EAD6",
          "image": "./assets/images/adlawatt-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow app to access your location for weather."
        }
      ],
      "expo-web-browser",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#00A86B",
          "defaultChannel": "adlawatt-alerts"
        }
      ],
      "expo-sharing",
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      [
        "@sentry/react-native/expo",
        {
          "organization": "adlawatt",
          "project": "adlawatt-kr",
          "url": "https://sentry.io/"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a", "armeabi-v7a"],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba375929-16f4-4a21-b339-8b43e93ecfd2"
      }
    },
    "owner": "fadrians-team"
  }
}
